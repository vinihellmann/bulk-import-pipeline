# Copy to .env for `npm run dev` / `npm run dev:worker` against the compose infrastructure
# (`docker compose up -d mysql redis minio minio-init elasticmq`).
# Every variable is validated with zod at startup (src/config/env.ts).

NODE_ENV=development
PORT=3000
# error | warn | info | debug
LOG_LEVEL=debug

# API keys are stored hashed (sha256) and bound to a client (tenant). Format:
#   API_KEYS=clientA:<sha256hex>,clientA:<sha256hex>,clientB:<sha256hex>
# Several entries per client allow rotation. Generate one with: npm run generate:api-key -- clientA
# Required in production.
# API_KEYS=
# Legacy/dev only (min 16 chars, plaintext, mapped to client "default"; rejected when NODE_ENV=production).
# Clients send it in the `x-api-key` header.
API_KEY=local-dev-api-key-change-me
# Comma-separated allowlist for browser clients (REST and Socket.io). Empty = no CORS.
CORS_ORIGINS=http://localhost:5173
# Express "trust proxy": false | true | <hop count> | comma list of CIDRs/names (loopback, 10.0.0.0/8).
# Set it when running behind a load balancer, otherwise every client shares the balancer's IP
# for rate limiting. Never "true" if the API is directly reachable from the internet.
TRUST_PROXY=false

# MySQL 8
DB_HOST=localhost
DB_PORT=3306
DB_USER=app
DB_PASSWORD=app
DB_NAME=bulk_import
# TLS to MySQL. DB_SSL_CA is PEM content or a file path. Verification is on by default.
DB_SSL=false
# DB_SSL_CA=/etc/ssl/rds-ca.pem
DB_SSL_REJECT_UNAUTHORIZED=true

# Use rediss:// for TLS. REDIS_TLS_CA (PEM content or file path) is for private CAs.
REDIS_URL=redis://localhost:6379
# REDIS_TLS_CA=/etc/ssl/redis-ca.pem

# AWS SDK v3. Locally these point at MinIO and ElasticMQ; on AWS leave S3_ENDPOINT,
# S3_PUBLIC_ENDPOINT and SQS_ENDPOINT empty and drop the static credentials (use an IAM role).
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

S3_BUCKET=imports
# Endpoint used by the services themselves.
S3_ENDPOINT=http://localhost:9000
# Endpoint embedded in presigned URLs (must be reachable by the uploading client).
S3_PUBLIC_ENDPOINT=http://localhost:9000
# Path-style URLs are required by MinIO; set to false on AWS.
S3_FORCE_PATH_STYLE=true
# Server-side encryption of uploaded objects: AES256 | aws:kms (unset = bucket default).
# S3_SSE=aws:kms
# S3_KMS_KEY_ID=arn:aws:kms:us-east-1:123456789012:key/...
# Lifetime of presigned upload URLs.
UPLOAD_URL_TTL_SECONDS=900

SQS_QUEUE_URL=http://localhost:9324/000000000000/imports
SQS_ENDPOINT=http://localhost:9324
# Must match the redrive policy (infra/elasticmq.conf). On the last receive the import is marked FAILED.
SQS_MAX_RECEIVE_COUNT=3
SQS_VISIBILITY_TIMEOUT_SECONDS=60
# Visibility is extended at this interval while an import is running (must be < visibility timeout).
SQS_HEARTBEAT_INTERVAL_SECONDS=20
SQS_WAIT_TIME_SECONDS=10
# Delay before a failed message becomes visible again.
SQS_RETRY_DELAY_SECONDS=10

# Sliding-window rate limits shared through Redis. RATE_LIMIT_IP_MAX applies per source IP
# before authentication (throttles key guessing); RATE_LIMIT_MAX per authenticated client.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
RATE_LIMIT_IP_MAX=600
# Max concurrent import subscriptions per Socket.io connection.
SOCKET_MAX_SUBSCRIPTIONS=20

# Max upload size in bytes (signed into the presigned URL, enforced again while streaming). Default 50 MiB.
MAX_UPLOAD_BYTES=52428800
# Max data rows per import.
IMPORT_MAX_ROWS=1000000
# A QUEUED import untouched for this long is re-enqueued when started again (lost SQS message).
IMPORT_REQUEUE_AFTER_MS=300000

# Rows per upsert transaction.
IMPORT_BATCH_SIZE=500
# Row errors stored per import (all errors are still counted).
IMPORT_MAX_STORED_ERRORS=1000
# Progress events are emitted when BOTH thresholds are crossed.
PROGRESS_EVERY_ROWS=500
PROGRESS_EVERY_MS=500
# Distributed lock per import (renewed every LOCK_RENEW_MS).
LOCK_TTL_MS=30000
LOCK_RENEW_MS=10000
# Time an in-flight import gets to finish on SIGTERM before it is aborted and redelivered.
SHUTDOWN_GRACE_MS=60000
