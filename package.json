{
  "name": "bulk-import-pipeline",
  "version": "1.0.0",
  "description": "Asynchronous, streaming bulk import pipeline for product catalogs (Express, SQS, S3, MySQL, Redis, Socket.io).",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "dev:worker": "tsx watch --env-file=.env src/worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "migrate": "tsx --env-file=.env src/infra/db/migrate.ts",
    "migrate:prod": "node dist/infra/db/migrate.js",
    "lint": "oxlint src __tests__ scripts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "jest --config jest.config.js",
    "test:integration": "jest --config jest.integration.config.js --runInBand",
    "test:docker": "docker compose -f docker-compose.yml -f docker-compose.test.yml run --build --rm test",
    "generate:fixture": "tsx scripts/generate-fixture.ts",
    "generate:api-key": "tsx scripts/generate-api-key.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1136.0",
    "@aws-sdk/client-sqs": "^3.1136.0",
    "@aws-sdk/s3-request-presigner": "^3.1136.0",
    "@scalar/express-api-reference": "^0.10.36",
    "@socket.io/redis-adapter": "^8.3.0",
    "@socket.io/redis-emitter": "^5.1.0",
    "cors": "^2.8.5",
    "csv-parse": "^7.0.3",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.6.1",
    "mysql2": "^3.14.0",
    "sequelize": "^6.37.7",
    "socket.io": "^4.8.1",
    "sqs-consumer": "^15.0.4",
    "umzug": "^3.8.2",
    "winston": "^3.17.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@swc/core": "^1.11.0",
    "@swc/jest": "^0.2.38",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.0",
    "@types/supertest": "^6.0.3",
    "jest": "^29.7.0",
    "oxlint": "^1.0.0",
    "prettier": "^3.5.0",
    "socket.io-client": "^4.8.1",
    "supertest": "^7.1.0",
    "tsx": "^4.19.4",
    "typescript": "~5.9.2"
  }
}
